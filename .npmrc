# Prevent bun from creating node_modules/.bin/esbuild symlink.
# If bun respects this → symlink never exists → OnSpace pre-check gets ENOENT (handled gracefully).
# If bun ignores this → lifecycle-scripts=true in bunfig.toml ensures esbuild postinstall
#   runs chmod +x → binary is executable → OnSpace pre-check passes.
bin-links=false
