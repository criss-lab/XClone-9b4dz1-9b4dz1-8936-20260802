{
  "name": "esbuild",
  "version": "0.21.5",
  "description": "An extremely fast JavaScript and CSS bundler and minifier",
  "license": "MIT",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "postinstall": "node -e \"var e=require('child_process'),p=['node_modules/.bin/esbuild','node_modules/esbuild/bin/esbuild','node_modules/@esbuild/linux-x64/bin/esbuild'];p.forEach(function(f){try{e.execSync('chmod +x '+f+' 2>/dev/null')}catch(_){}})\""
  }
}
